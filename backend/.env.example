# Application
PROJECT_NAME=UPSC OS API
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ENCRYPTION_KEY=change-this-to-a-random-encryption-key

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=upscos
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=upscos

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_BUCKET=upscos-assets
MINIO_SECURE=false

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
